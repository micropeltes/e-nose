#include <Arduino.h>
#include <Wire.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <Adafruit_ADS1X15.h>
#include <time.h>
#include <stdlib.h>
#include <string.h>
#include "credentials.h"

// ================= CONFIG =================
constexpr char DEVICE_ID[] = "ESP-00";

constexpr uint8_t I2C_SDA_PIN = 10;
constexpr uint8_t I2C_SCL_PIN = 6;
constexpr uint32_t I2C_CLOCK_HZ = 100000;

constexpr uint32_t WIFI_CONNECT_TIMEOUT_MS = 15000;
constexpr uint32_t WIFI_RECONNECT_INTERVAL_MS = 10000;
constexpr uint32_t TIME_SYNC_TIMEOUT_MS = 15000;

constexpr uint8_t ADS_ADDR_OPEN = 0x48;
constexpr uint8_t ADS_ADDR_SDA_SHORT = 0x4A;
constexpr uint8_t ADS_INIT_RETRY_COUNT = 5;
constexpr uint32_t ADS_INIT_RETRY_DELAY_MS = 500;
constexpr uint32_t SENSOR_READ_INTERVAL_MS = 500;
constexpr adsGain_t ADS_GAIN = GAIN_ONE;  // +/-4.096V, aman untuk sinyal sensor 3.3V.

constexpr char MQTT_DATA_TOPIC[] = "device/data";
constexpr char MQTT_ERROR_TOPIC[] = "device/error";
constexpr char MQTT_INTERVAL_TOPIC[] = "sensor/control";
constexpr uint32_t MQTT_INTERVAL_MIN_MS = 200;
constexpr uint32_t MQTT_INTERVAL_MAX_MS = 60000;
constexpr uint32_t MQTT_INTERVAL_DEFAULT_MS = 1000;
constexpr uint32_t MQTT_RECONNECT_INTERVAL_MS = 5000;
constexpr uint32_t MQTT_LOOP_DELAY_MS = 50;
constexpr uint32_t ERROR_REPEAT_INTERVAL_MS = 30000;

constexpr size_t ERROR_LOG_QUEUE_SIZE = 8;
constexpr size_t ERROR_LOG_MAX_LEN = 180;

// ================= STATE =================
struct SensorReadings {
  int16_t mq135 = -1;
  int16_t co = -1;
  int16_t nh3Mics = -1;
  int16_t no2 = -1;
  int16_t h2s = -1;
  int16_t nh3Mems = -1;
};

struct AdsState {
  bool memsOk = false;
  bool micsOk = false;
};

SensorReadings readings;
AdsState adsState;
volatile uint32_t mqttPublishIntervalMs = MQTT_INTERVAL_DEFAULT_MS;
SemaphoreHandle_t readingsMutex = nullptr;

char errorLogQueue[ERROR_LOG_QUEUE_SIZE][ERROR_LOG_MAX_LEN];
size_t errorLogHead = 0;
size_t errorLogCount = 0;
uint32_t lastWiFiErrorLogMs = 0;
uint32_t lastMqttConnectErrorLogMs = 0;
uint32_t lastMqttOfflineLogMs = 0;
uint32_t lastPublishErrorLogMs = 0;

Adafruit_ADS1115 adsMems;       // ADDR open / 0x48: H2S MEMS + NH3 MEMS.
Adafruit_ADS1115 adsMicsMq135;  // ADDR short ke SDA / 0x4A: MQ135 + MICS.

WiFiClientSecure espClient;
PubSubClient client(espClient);

TaskHandle_t TaskSensorHandle;
TaskHandle_t TaskMQTTHandle;

// ================= ERROR LOG =================
void enqueueErrorLog(const char* payload) {
  size_t writeIndex = (errorLogHead + errorLogCount) % ERROR_LOG_QUEUE_SIZE;

  if (errorLogCount == ERROR_LOG_QUEUE_SIZE) {
    writeIndex = errorLogHead;
    errorLogHead = (errorLogHead + 1) % ERROR_LOG_QUEUE_SIZE;
  } else {
    errorLogCount++;
  }

  strncpy(errorLogQueue[writeIndex], payload, ERROR_LOG_MAX_LEN - 1);
  errorLogQueue[writeIndex][ERROR_LOG_MAX_LEN - 1] = '\0';
}

void logError(const char* msg) {
  Serial.print("ERROR: ");
  Serial.println(msg);

  char payload[ERROR_LOG_MAX_LEN];
  snprintf(payload, sizeof(payload),
    "{\"devid\":\"%s\",\"timestamp\":%ld,\"error\":\"%s\"}",
    DEVICE_ID,
    (long)time(nullptr),
    msg
  );

  if (!client.connected() || !client.publish(MQTT_ERROR_TOPIC, payload)) {
    enqueueErrorLog(payload);
  }
}

void logErrorThrottled(const char* msg, uint32_t& lastLogMs) {
  uint32_t nowMs = millis();
  if (lastLogMs != 0 && nowMs - lastLogMs < ERROR_REPEAT_INTERVAL_MS) {
    return;
  }

  lastLogMs = (nowMs == 0) ? 1 : nowMs;
  logError(msg);
}

void flushErrorLogs() {
  while (client.connected() && errorLogCount > 0) {
    if (!client.publish(MQTT_ERROR_TOPIC, errorLogQueue[errorLogHead])) {
      return;
    }

    errorLogHead = (errorLogHead + 1) % ERROR_LOG_QUEUE_SIZE;
    errorLogCount--;
  }
}

void storeSensorReadings(const SensorReadings& nextReadings) {
  if (readingsMutex != nullptr && xSemaphoreTake(readingsMutex, portMAX_DELAY) == pdTRUE) {
    readings = nextReadings;
    xSemaphoreGive(readingsMutex);
    return;
  }

  readings = nextReadings;
}

SensorReadings getSensorReadingsSnapshot() {
  SensorReadings snapshot;
  if (readingsMutex != nullptr && xSemaphoreTake(readingsMutex, portMAX_DELAY) == pdTRUE) {
    snapshot = readings;
    xSemaphoreGive(readingsMutex);
    return snapshot;
  }

  return readings;
}

// ================= MQTT CONTROL =================
bool parseIntervalFromPayload(const byte* payload, unsigned int length, uint32_t& outMs) {
  char msg[64];
  unsigned int copyLen = (length < sizeof(msg) - 1) ? length : (sizeof(msg) - 1);
  memcpy(msg, payload, copyLen);
  msg[copyLen] = '\0';

  char* p = msg;
  while (*p != '\0' && (*p < '0' || *p > '9')) {
    p++;
  }
  if (*p == '\0') {
    return false;
  }

  char* endPtr = nullptr;
  unsigned long value = strtoul(p, &endPtr, 10);
  if (endPtr == p || value < MQTT_INTERVAL_MIN_MS || value > MQTT_INTERVAL_MAX_MS) {
    return false;
  }

  outMs = static_cast<uint32_t>(value);
  return true;
}

void handleIntervalConfigMessage(const byte* payload, unsigned int length) {
  uint32_t newIntervalMs = 0;
  if (parseIntervalFromPayload(payload, length, newIntervalMs)) {
    mqttPublishIntervalMs = newIntervalMs;
    Serial.print("MQTT interval updated to ");
    Serial.print(mqttPublishIntervalMs);
    Serial.println(" ms");
    return;
  }

  Serial.print("Invalid interval payload. Use ");
  Serial.print(MQTT_INTERVAL_MIN_MS);
  Serial.print("..");
  Serial.print(MQTT_INTERVAL_MAX_MS);
  Serial.println(" (ms)");
  logError("Invalid interval payload");
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  Serial.print("Message on: ");
  Serial.println(topic);

  if (strcmp(topic, MQTT_INTERVAL_TOPIC) == 0) {
    handleIntervalConfigMessage(payload, length);
  }
}

void reconnectMQTT() {
  if (client.connected()) {
    return;
  }
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  static uint32_t lastReconnectAttemptMs = 0;
  uint32_t nowMs = millis();
  if (lastReconnectAttemptMs != 0 && nowMs - lastReconnectAttemptMs < MQTT_RECONNECT_INTERVAL_MS) {
    return;
  }
  lastReconnectAttemptMs = (nowMs == 0) ? 1 : nowMs;

  Serial.println("MQTT reconnecting...");
  if (client.connect(MQTT_CLIENT_ID)) {
    Serial.println("MQTT Connected");
    lastReconnectAttemptMs = 0;
    if (!client.subscribe(MQTT_INTERVAL_TOPIC)) {
      logError("MQTT subscribe interval topic gagal");
    }
    flushErrorLogs();
    return;
  }

  Serial.print("MQTT Failed, rc=");
  Serial.println(client.state());

  char errMsg[64];
  snprintf(errMsg, sizeof(errMsg), "MQTT connect failed, rc=%d", client.state());
  logErrorThrottled(errMsg, lastMqttConnectErrorLogMs);
}

// ================= WIFI + TIME =================
bool connectWiFi(uint32_t timeoutMs = WIFI_CONNECT_TIMEOUT_MS) {
  if (WiFi.status() == WL_CONNECTED) {
    return true;
  }

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting WiFi");
  uint32_t startMs = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startMs < timeoutMs) {
    Serial.print(".");
    delay(500);
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi Connected");
    return true;
  }

  Serial.println("\nWiFi connect timeout");
  return false;
}

void ensureWiFiConnected() {
  if (WiFi.status() == WL_CONNECTED) {
    return;
  }

  static uint32_t lastReconnectAttemptMs = 0;
  uint32_t nowMs = millis();
  if (lastReconnectAttemptMs != 0 && nowMs - lastReconnectAttemptMs < WIFI_RECONNECT_INTERVAL_MS) {
    return;
  }
  lastReconnectAttemptMs = (nowMs == 0) ? 1 : nowMs;

  if (!connectWiFi()) {
    logErrorThrottled("WiFi connect timeout", lastWiFiErrorLogMs);
  }
}

bool syncTime() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Skip time sync: WiFi not connected");
    return false;
  }

  configTime(0, 0, "time.google.com", "pool.ntp.org", "time.nist.gov");

  Serial.print("Sync time");
  time_t now = time(nullptr);
  uint32_t startMs = millis();
  while (now < 100000 && millis() - startMs < TIME_SYNC_TIMEOUT_MS) {
    delay(500);
    Serial.print(".");
    now = time(nullptr);
  }

  if (now >= 100000) {
    Serial.println(" OK");
    return true;
  }

  Serial.println(" FAILED");
  logError("Time sync failed");
  return false;
}

// ================= I2C + ADS1115 =================
void scanI2C() {
  Serial.println("Scanning I2C...");
  for (byte addr = 1; addr < 127; addr++) {
    Wire.beginTransmission(addr);
    if (Wire.endTransmission() == 0) {
      Serial.print("Found device at 0x");
      Serial.println(addr, HEX);
    }
  }
}

void beginI2C() {
  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  Wire.setClock(I2C_CLOCK_HZ);
  scanI2C();
}

bool beginAds(Adafruit_ADS1115& ads, uint8_t address) {
  if (!ads.begin(address)) {
    return false;
  }

  ads.setGain(ADS_GAIN);
  return true;
}

void initAdsDevices() {
  for (uint8_t attempt = 1; attempt <= ADS_INIT_RETRY_COUNT; attempt++) {
    if (!adsState.memsOk) {
      adsState.memsOk = beginAds(adsMems, ADS_ADDR_OPEN);
    }
    if (!adsState.micsOk) {
      adsState.micsOk = beginAds(adsMicsMq135, ADS_ADDR_SDA_SHORT);
    }

    if (adsState.memsOk && adsState.micsOk) {
      Serial.println("ADS1115 detected: 0x48 and 0x4A");
      return;
    }

    Serial.print("ADS init retry ");
    Serial.print(attempt);
    Serial.print("/");
    Serial.println(ADS_INIT_RETRY_COUNT);
    delay(ADS_INIT_RETRY_DELAY_MS);
  }

  if (!adsState.memsOk) {
    logError("ADS1115 OPEN ADDR (0x48) MEMS NOT DETECTED");
  }
  if (!adsState.micsOk) {
    logError("ADS1115 ADDR-SDA SHORT (0x4A) MICS/MQ135 NOT DETECTED");
  }
}

// ================= SENSOR =================
void readMicsMq135Ads(SensorReadings& nextReadings) {
  if (!adsState.micsOk) {
    nextReadings.mq135 = -1;
    nextReadings.co = -1;
    nextReadings.nh3Mics = -1;
    nextReadings.no2 = -1;
    return;
  }

  nextReadings.mq135 = adsMicsMq135.readADC_SingleEnded(0);
  nextReadings.co = adsMicsMq135.readADC_SingleEnded(1);
  nextReadings.nh3Mics = adsMicsMq135.readADC_SingleEnded(2);
  nextReadings.no2 = adsMicsMq135.readADC_SingleEnded(3);
}

void readMemsAds(SensorReadings& nextReadings) {
  if (!adsState.memsOk) {
    nextReadings.h2s = -1;
    nextReadings.nh3Mems = -1;
    return;
  }

  nextReadings.h2s = adsMems.readADC_SingleEnded(2);
  nextReadings.nh3Mems = adsMems.readADC_SingleEnded(3);
}

void readSensors() {
  SensorReadings nextReadings;
  readMicsMq135Ads(nextReadings);
  readMemsAds(nextReadings);
  storeSensorReadings(nextReadings);
}

void buildDataPayload(char* payload, size_t payloadSize, const SensorReadings& snapshot) {
  snprintf(payload, payloadSize,
    "{\"devid\":\"%s\",\"nh3_mics\":%d,\"nh3_mems\":%d,"
    "\"h2s\":%d,\"no2\":%d,\"co\":%d,\"mq135\":%d,\"timestamp\":%ld}",
    DEVICE_ID,
    snapshot.nh3Mics,
    snapshot.nh3Mems,
    snapshot.h2s,
    snapshot.no2,
    snapshot.co,
    snapshot.mq135,
    (long)time(nullptr)
  );
}

void publishSensorData() {
  char payload[256];
  SensorReadings snapshot = getSensorReadingsSnapshot();
  buildDataPayload(payload, sizeof(payload), snapshot);

  if (!client.connected()) {
    logErrorThrottled("MQTT tidak connected", lastMqttOfflineLogMs);
    Serial.println(payload);
    return;
  }

  if (!client.publish(MQTT_DATA_TOPIC, payload)) {
    logErrorThrottled("Publish sensor payload gagal", lastPublishErrorLogMs);
  }

  Serial.println(payload);
}

// ================= TASKS =================
void TaskSensor(void* parameter) {
  for (;;) {
    readSensors();
    vTaskDelay(SENSOR_READ_INTERVAL_MS / portTICK_PERIOD_MS);
  }
}

void TaskMQTT(void* parameter) {
  uint32_t lastPublishMs = 0;

  for (;;) {
    ensureWiFiConnected();
    reconnectMQTT();
    if (client.connected()) {
      client.loop();
      flushErrorLogs();
    }

    uint32_t nowMs = millis();
    uint32_t intervalMs = mqttPublishIntervalMs;
    if (lastPublishMs == 0 || nowMs - lastPublishMs >= intervalMs) {
      lastPublishMs = nowMs;
      publishSensorData();
    }

    vTaskDelay(MQTT_LOOP_DELAY_MS / portTICK_PERIOD_MS);
  }
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);
  readingsMutex = xSemaphoreCreateMutex();

  beginI2C();
  connectWiFi();
  syncTime();
  initAdsDevices();

  espClient.setInsecure();
  client.setServer(MQTT_SERVER, MQTT_PORT);
  client.setBufferSize(384);
  client.setCallback(mqttCallback);

  xTaskCreate(TaskSensor, "SensorTask", 4096, NULL, 1, &TaskSensorHandle);
  xTaskCreate(TaskMQTT, "MQTTTask", 4096, NULL, 1, &TaskMQTTHandle);
}

void loop() {
}
